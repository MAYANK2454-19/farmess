# Browser-safe Supabase configuration. The publishable key is not a secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only external data providers. Never use NEXT_PUBLIC_ for these values.
DATA_GOV_IN_API_KEY=
HEIGIT_API_KEY=

# Optional paid Open-Meteo customer endpoint. Leave blank for non-commercial evaluation use.
OPEN_METEO_CUSTOMER_API_KEY=

# Optional local-only ML export credentials. Never expose these through NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
FARMESS_ML_EXPORT_SALT=
