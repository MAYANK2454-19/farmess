# Browser-safe Supabase configuration. The publishable key is not a secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only external data providers. Never use NEXT_PUBLIC_ for these values.
# Use your personal key from data.gov.in -> My Account. The public sample key shown on
# dataset pages returns only 10 rows per request and is heavily rate-limited.
DATA_GOV_IN_API_KEY=
HEIGIT_API_KEY=

# Optional paid Open-Meteo customer endpoint. Leave blank for non-commercial evaluation use.
OPEN_METEO_CUSTOMER_API_KEY=

# Set to "true" only if this deployment is non-commercial (e.g. an academic project).
# It allows the free Open-Meteo endpoint on Vercel production when no paid key is set.
OPEN_METEO_NON_COMMERCIAL_USE=

# Server secret: 64 random hexadecimal characters, the same value in Vercel and .env.local.
# The server derives two things from it: the token that lets it save fetched mandi prices
# (the database holds only that token's hash), and the private admin sign-in address
# (print it with: node scripts/print-admin-link.mjs). Never commit or share the value.
FARMESS_SERVER_SECRET=

# Local only, never in Vercel: used by scripts/translate-i18n.mjs to translate the interface.
GEMINI_API_KEY=

# Optional local-only ML export credentials. Never expose these through NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
FARMESS_ML_EXPORT_SALT=
