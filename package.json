{
  "name": "farmess",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "format": "prettier --write .",
    "format:check": "node scripts/check-format.mjs",
    "prepare": "simple-git-hooks || true",
    "seed:demo": "node scripts/seed-demo-data.mjs"
  },
  "simple-git-hooks": {
    "pre-commit": "sh scripts/pre-commit.sh"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^22.15.30",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.6.2",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "4.3.5",
    "typescript": "^5.9.3",
    "@types/leaflet": "1.9.22"
  },
  "description": "Farmers, buyers and service providers decision-support workspace"
}
