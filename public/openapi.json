    "/api/produce-lots/{lotId}/quality-inspections": {
      "parameters": [
        {
          "name": "lotId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "tags": ["Farmer"],
        "summary": "Append-only quality inspection history for one of the farmer's lots",
        "responses": {
          "200": {
            "description": "Inspections, newest first"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "Lot not found"
          }
        }
      },
      "post": {
        "tags": ["Farmer"],
        "summary": "Record a farmer-entered quality inspection (server timestamp; not a certified grade)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["checks"],
                "additionalProperties": false,
                "properties": {
                  "checks": {
                    "type": "object",
                    "description": "Up to six checks; omitted checks count as not recorded.",
                    "additionalProperties": false,
                    "properties": {
                      "appearance": {
                        "type": "string",
                        "enum": ["acceptable", "issue_found", "not_assessed"]
                      },
                      "physical_damage": {
                        "type": "string",
                        "enum": ["acceptable", "issue_found", "not_assessed"]
                      },
                      "pest_or_contamination": {
                        "type": "string",
                        "enum": ["acceptable", "issue_found", "not_assessed"]
                      },
                      "moisture_condition": {
                        "type": "string",
                        "enum": ["acceptable", "issue_found", "not_assessed"]
                      },
                      "packaging_condition": {
                        "type": "string",
                        "enum": ["acceptable", "issue_found", "not_assessed"]
                      },
                      "temperature_handling": {
                        "type": "string",
                        "enum": ["acceptable", "issue_found", "not_assessed"]
                      }
                    }
                  },
                  "observations": {
                    "type": "string",
                    "maxLength": 1000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Inspection saved"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "Lot not found"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
